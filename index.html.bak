<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Helio is the Solana-native smart wallet that rounds up every transaction and auto-invests your spare change."
    />
    <title>Helio | Round Up Every Transaction Into Yield</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="page-glow page-glow-left"></div>
    <div class="page-glow page-glow-right"></div>

    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand brand-logo" href="#home" aria-label="Helio home">
          <img
            class="brand-asset brand-asset-nav"
            src="Untitled design.png"
            alt="Helio"
            width="1772"
            height="1181"
          />
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href="#how-it-works">How It Works</a>
          <a href="#features">Features</a>
          <a href="#destinations">Destinations</a>
          <a href="#waitlist">Waitlist</a>
        </nav>

        <a class="nav-cta" href="#waitlist">Join Waitlist</a>
      </div>
    </header>

    <main>
      <section class="hero" id="home">
        <canvas class="hero-particles" id="hero-particles" aria-hidden="true"></canvas>
        <div class="hero-grid"></div>
        <div class="container hero-layout">
          <div class="hero-copy">
            <div class="eyebrow reveal">
              <span class="eyebrow-dot"></span>
              Solana-native automation for idle capital
            </div>
            <h1 class="reveal">
              Your wallet rounds up.
              <span class="headline-accent">Your money grows up.</span>
            </h1>
            <p class="hero-subhead reveal">
              Helio automatically invests your spare change on every Solana
              transaction into staking, tokenized gold, or index tokens with
              zero manual work.
            </p>
            <div class="hero-actions reveal">
              <a class="button button-primary" href="#waitlist">
                Download Extension
              </a>
              <a class="button button-ghost" href="#simulator">
                See How It Works
              </a>
            </div>
            <ul class="hero-metrics reveal" aria-label="Product highlights">
              <li>
                <strong>Auto-invest</strong>
                <span>Rounds every outgoing payment to your threshold</span>
              </li>
              <li>
                <strong>Smart routed</strong>
                <span>Shifts micro-capital toward the best fit destination</span>
              </li>
              <li>
                <strong>Non-custodial</strong>
                <span>Your wallet, your keys, your yield positions</span>
              </li>
            </ul>
          </div>

          <div class="hero-visual reveal">
            <div class="floating-orb" aria-hidden="true"></div>
            <div class="mockup-shell">
              <div class="mockup-header">
                <div class="mockup-brand">
                  <img
                    class="mockup-brand-logo"
                    src="Untitled design.png"
                    alt="Helio"
                    width="1772"
                    height="1181"
                  />
                  <div>
                    <p>Extension</p>
                    <strong>Passive yield mode</strong>
                  </div>
                </div>
                <span class="status-pill">Live on mainnet</span>
              </div>

              <div class="portfolio-panel">
                <div class="portfolio-card portfolio-card-primary">
                  <span>Total spare change routed</span>
                  <strong>$1,248.43</strong>
                  <div class="yield-chip">
                    <span>+7.2% avg APY</span>
                    <span>Auto-compounding</span>
                  </div>
                </div>

                <div class="mockup-breakdown">
                  <div class="breakdown-card">
                    <span>Current route</span>
                    <strong>SOL Staking</strong>
                    <small>1-click switch enabled</small>
                  </div>
                  <div class="breakdown-card">
                    <span>Last round-up</span>
                    <strong>$0.40</strong>
                    <small>Captured from a $4.60 swap</small>
                  </div>
                </div>

                <div class="chart-card">
                  <div class="chart-header">
                    <div>
                      <span>Yield trajectory</span>
                      <strong>30 day growth curve</strong>
                    </div>
                    <span class="chart-tag">Projected</span>
                  </div>
                  <div class="chart-bars" aria-hidden="true">
                    <span style="--bar-height: 30%"></span>
                    <span style="--bar-height: 42%"></span>
                    <span style="--bar-height: 54%"></span>
                    <span style="--bar-height: 61%"></span>
                    <span style="--bar-height: 78%"></span>
                    <span style="--bar-height: 92%"></span>
                  </div>
                </div>
              </div>
            </div>

            <div class="floating-card floating-card-top">
              <span>Round-up triggered</span>
              <strong>$0.40 routed</strong>
              <small>USDC payment sent at 11:23</small>
            </div>

            <div class="floating-card floating-card-bottom">
              <span>Best route</span>
              <strong>SOL staking selected</strong>
              <small>Validator APY currently leads</small>
            </div>
          </div>
        </div>
      </section>

      <section class="section simulator-section" id="simulator">
        <div class="container">
          <div class="section-heading reveal">
            <span class="section-label">Live Round-Up Simulator</span>
            <h2>Watch your spare change grow</h2>
            <p>
              Model one payment, pick a round-up threshold, and see how Helio
              continuously routes the delta into yield-generating assets.
            </p>
          </div>

          <div class="simulator-layout">
            <div class="glass-card simulator-control reveal">
              <div class="control-group">
                <label for="transaction-amount">Transaction amount</label>
                <div class="amount-input-shell">
                  <span>$</span>
                  <input
                    id="transaction-amount"
                    name="transaction-amount"
                    type="number"
                    min="0.01"
                    max="500"
                    step="0.01"
                    value="4.60"
                  />
                </div>
                <input
                  id="transaction-range"
                  type="range"
                  min="0.01"
                  max="250"
                  step="0.01"
                  value="4.60"
                />
              </div>

              <div class="control-group">
                <span class="control-label">Round to the nearest</span>
                <div class="pill-group" role="group" aria-label="Round-up threshold">
                  <button class="threshold-pill active" data-threshold="0.5" type="button">
                    $0.50
                  </button>
                  <button class="threshold-pill" data-threshold="1" type="button">
                    $1
                  </button>
                  <button class="threshold-pill" data-threshold="2" type="button">
                    $2
                  </button>
                  <button class="threshold-pill" data-threshold="5" type="button">
                    $5
                  </button>
                </div>
              </div>

              <div class="control-group">
                <span class="control-label">Investment destination</span>
                <div class="destination-switcher" aria-label="Investment destination">
                  <button class="destination-pill active" data-destination="staking" type="button">
                    <span>SOL Staking</span>
                    <small>7.2% APY • Native yield</small>
                  </button>
                  <button class="destination-pill" data-destination="gold" type="button">
                    <span>Tokenized Gold</span>
                    <small>4.6% APY • Inflation hedge</small>
                  </button>
                  <button class="destination-pill" data-destination="index" type="button">
                    <span>Index Token</span>
                    <small>11.4% APY • Basket exposure</small>
                  </button>
                </div>
              </div>
            </div>

            <div class="simulator-output reveal">
              <div class="glass-card output-card output-card-primary">
                <span class="mini-label">This transaction</span>
                <h3 id="delta-output">$0.40 invested</h3>
                <p id="delta-note">
                  Rounded from $4.60 to $5.00 and routed to SOL staking.
                </p>
              </div>

              <div class="output-grid">
                <div class="glass-card output-card">
                  <span class="mini-label">Projected monthly</span>
                  <strong id="monthly-output">$240.00 / month</strong>
                  <p>Assumes 20 transactions per day at the current delta.</p>
                </div>
                <div class="glass-card output-card">
                  <span class="mini-label">Estimated annual yield</span>
                  <strong id="annual-output">$109.80 / year</strong>
                  <p id="annual-note">Based on a 7.2% APY with daily round-ups.</p>
                </div>
              </div>

              <div class="glass-card simulator-visual-card">
                <div class="visual-header">
                  <div>
                    <span class="mini-label">How Helio routes value</span>
                    <strong>Round-up engine</strong>
                  </div>
                  <span class="route-badge" id="route-badge">SOL Staking</span>
                </div>

                <div class="flow-list">
                  <div class="flow-step">
                    <strong id="flow-spend">$4.60</strong>
                    <span>Payment sent</span>
                  </div>
                  <div class="flow-arrow" aria-hidden="true"></div>
                  <div class="flow-step">
                    <strong id="flow-round">$0.40</strong>
                    <span>Spare change captured</span>
                  </div>
                  <div class="flow-arrow" aria-hidden="true"></div>
                  <div class="flow-step">
                    <strong id="flow-apy">7.2% APY</strong>
                    <span>Destination accrual rate</span>
                  </div>
                </div>

                <div class="projection-panel">
                  <div>
                    <span>Annual contributions</span>
                    <strong id="principal-output">$2,920.00</strong>
                  </div>
                  <div>
                    <span>Projected 12 mo value</span>
                    <strong id="portfolio-output">$3,029.80</strong>
                  </div>
                  <div>
                    <span>Chosen route</span>
                    <strong id="destination-copy">Stake with validators</strong>
                  </div>
                </div>

                <p class="simulator-footnote">
                  Mock data only. APY and routing are shown for illustration.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="how-it-works">
        <div class="container">
          <div class="section-heading reveal">
            <span class="section-label">How It Works</span>
            <h2>Three steps. Zero effort.</h2>
            <p>
              Helio makes passive micro-investing feel invisible. Set it once,
              then let every transaction build long-term positions behind the
              scenes.
            </p>
          </div>

          <div class="steps-track reveal">
            <article class="glass-card step-card">
              <div class="step-icon">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M6 16H26M18 8L26 16L18 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                  ></path>
                </svg>
              </div>
              <span class="step-number">Step 1</span>
              <h3>Connect</h3>
              <p>Link your Solana wallet to Helio in one click.</p>
            </article>

            <article class="glass-card step-card">
              <div class="step-icon">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M9 9H23V23H9zM12 16H20"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                  ></path>
                </svg>
              </div>
              <span class="step-number">Step 2</span>
              <h3>Choose</h3>
              <p>Pick where your spare change gets invested.</p>
            </article>

            <article class="glass-card step-card">
              <div class="step-icon">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M8 22L14 16L18 20L25 11"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                  ></path>
                  <path
                    d="M21 11H25V15"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                  ></path>
                </svg>
              </div>
              <span class="step-number">Step 3</span>
              <h3>Transact</h3>
              <p>Every payment auto-rounds up and invests the delta.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="container">
          <div class="section-heading reveal">
            <span class="section-label">Features Breakdown</span>
            <h2>Built for passive wealth. Designed for DeFi natives.</h2>
            <p>
              Helio compresses smart routing, automated investing, and
              non-custodial control into one wallet-native loop.
            </p>
          </div>

          <div class="feature-grid">
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M17 4L9 18H15L13 28L23 13H17L17 4Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                </svg>
              </div>
              <h3>Instant Round-Ups</h3>
              <p>No manual triggers. Every transaction auto-invests.</p>
            </article>
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M10 14V10C10 6.686 12.686 4 16 4C19.314 4 22 6.686 22 10V14M9 14H23V27H9z"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                </svg>
              </div>
              <h3>Non-Custodial</h3>
              <p>Your keys, your funds, and your positions stay yours.</p>
            </article>
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M6 22L12 16L17 20L26 9"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                  <path
                    d="M21 9H26V14"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                </svg>
              </div>
              <h3>Dynamic Yield Routing</h3>
              <p>Helio selects the strongest APY path for your strategy.</p>
            </article>
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <circle
                    cx="12"
                    cy="12"
                    r="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                  ></circle>
                  <circle
                    cx="21"
                    cy="16"
                    r="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                  ></circle>
                  <circle
                    cx="14"
                    cy="22"
                    r="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                  ></circle>
                </svg>
              </div>
              <h3>Multi-Asset Support</h3>
              <p>Choose SOL staking, tokenized gold, or index tokens.</p>
            </article>
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M20 7H26V13M12 25H6V19M26 13C24 8 18 5.5 13 7M6 19C8 24 14 26.5 19 25"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                </svg>
              </div>
              <h3>Switch Anytime</h3>
              <p>Change your investment destination instantly and safely.</p>
            </article>
            <article class="glass-card feature-card reveal">
              <div class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" role="presentation">
                  <path
                    d="M6 20C8 18.2 10 17.3 12 17.3C14.7 17.3 16 18.9 18.5 18.9C20.7 18.9 22.2 17.8 26 14M6 12C8 10.2 10 9.3 12 9.3C14.7 9.3 16 10.9 18.5 10.9C20.7 10.9 22.2 9.8 26 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  ></path>
                </svg>
              </div>
              <h3>Solana-Native</h3>
              <p>Sub-second finality meets near-zero network fees.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="destinations">
        <div class="container">
          <div class="section-heading reveal">
            <span class="section-label">Investment Destinations</span>
            <h2>Where does your spare change go?</h2>
            <p>
              Every route stays liquid, non-custodial, and tuned for a
              different objective, from native yield to real-world hedges.
            </p>
          </div>

          <div class="destination-grid">
            <article
              class="glass-card destination-card active reveal"
              data-destination-card="staking"
              role="button"
              tabindex="0"
              aria-label="Select SOL Staking destination"
            >
              <div class="destination-header">
                <div class="destination-icon">◎</div>
                <span class="apy-badge">7.2% APY</span>
              </div>
              <h3>SOL Staking</h3>
              <p>Stake with validators. Earn native yield.</p>
              <small>Best for low-friction compounding inside the Solana economy.</small>
              <a href="#simulator">Learn More</a>
            </article>

            <article
              class="glass-card destination-card reveal"
              data-destination-card="gold"
              role="button"
              tabindex="0"
              aria-label="Select Tokenized Gold destination"
            >
              <div class="destination-header">
                <div class="destination-icon">Au</div>
                <span class="apy-badge">4.6% APY</span>
              </div>
              <h3>Tokenized Gold</h3>
              <p>Hedge inflation. Hold real-world value on-chain.</p>
              <small>Built for users who want stability without leaving crypto rails.</small>
              <a href="#simulator">Learn More</a>
            </article>

            <article
              class="glass-card destination-card reveal"
              data-destination-card="index"
              role="button"
              tabindex="0"
              aria-label="Select Index Token destination"
            >
              <div class="destination-header">
                <div class="destination-icon">Σ</div>
                <span class="apy-badge">11.4% APY</span>
              </div>
              <h3>Index Token</h3>
              <p>Diversified crypto exposure. One token, many assets.</p>
              <small>Designed for broader upside without micromanaging positions.</small>
              <a href="#simulator">Learn More</a>
            </article>
          </div>
        </div>
      </section>

      <section class="stats-strip" aria-label="Helio platform stats">
        <div class="container stats-grid">
          <div class="stat-card reveal">
            <span>$2.4M+</span>
            <strong data-counter data-value="2400000" data-format="currency-short">$2.4M+</strong>
            <small>in spare change invested</small>
          </div>
          <div class="stat-card reveal">
            <span>18,400+</span>
            <strong data-counter data-value="18400" data-format="number-short">18,400+</strong>
            <small>wallets connected</small>
          </div>
          <div class="stat-card reveal">
            <span>7.2%</span>
            <strong data-counter data-value="7.2" data-format="percent">7.2%</strong>
            <small>avg APY earned</small>
          </div>
          <div class="stat-card reveal">
            <span>340,000+</span>
            <strong data-counter data-value="340000" data-format="number-short">340,000+</strong>
            <small>round-ups executed</small>
          </div>
        </div>
      </section>

      <section class="section" id="community">
        <div class="container">
          <div class="section-heading reveal">
            <span class="section-label">Testimonials</span>
            <h2>What the community is saying</h2>
            <p>
              Helio is built for people who already live on-chain and want
              wealth automation to disappear into the wallet layer.
            </p>
          </div>

          <div class="testimonial-grid">
            <article class="glass-card testimonial-card reveal">
              <div class="testimonial-head">
                <div class="avatar">LM</div>
                <div>
                  <strong>Lena M.</strong>
                  <span>@lenaonchain</span>
                </div>
              </div>
              <p>
                “I didn’t even notice the round-ups and somehow I had $80 staked
                by the end of the month. That’s the right kind of automation.”
              </p>
            </article>

            <article class="glass-card testimonial-card reveal">
              <div class="testimonial-head">
                <div class="avatar">RK</div>
                <div>
                  <strong>Rishi K.</strong>
                  <span>@solrishi</span>
                </div>
              </div>
              <p>
                “Most wallets stop at sending and swapping. Helio treats every
                transaction like a portfolio event. That’s a stronger product
                thesis.”
              </p>
            </article>

            <article class="glass-card testimonial-card reveal">
              <div class="testimonial-head">
                <div class="avatar">AN</div>
                <div>
                  <strong>Ana N.</strong>
                  <span>@yieldlayer</span>
                </div>
              </div>
              <p>
                “The gold route is clever. It gives me a low-maintenance hedge
                without opening another app or manually managing tiny balances.”
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section waitlist-section" id="waitlist">
        <div class="container">
          <div class="waitlist-shell reveal">
            <div class="waitlist-copy">
              <span class="section-label">Waitlist / CTA</span>
              <h2>Start growing with every transaction.</h2>
              <p>
                Join the waitlist or download the extension today. Helio is
                designed for people who expect their wallet to move capital with
                more intelligence than a balance sheet.
              </p>
              <div class="platform-badges">
                <span class="platform-badge">
                  <span class="chrome-mark" aria-hidden="true"></span>
                  Available on Chrome
                </span>
                <span class="platform-badge">
                  <span class="solana-mark" aria-hidden="true"></span>
                  Solana Mainnet
                </span>
              </div>
            </div>

            <form class="waitlist-form" id="waitlist-form">
              <label class="sr-only" for="waitlist-email">Email address</label>
              <input
                id="waitlist-email"
                name="email"
                type="email"
                placeholder="Enter your email"
                autocomplete="email"
                required
              />
              <button class="button button-primary" type="submit">
                Join Waitlist
              </button>
              <p class="form-caption">No spam. Product updates and early access only.</p>
              <p class="form-feedback" id="form-feedback" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="footer">
      <div class="container footer-shell">
        <div class="footer-brand">
          <a class="brand brand-logo brand-logo-footer" href="#home" aria-label="Helio home">
            <img
              class="brand-asset brand-asset-footer"
              src="Untitled design.png"
              alt="Helio"
              width="1772"
              height="1181"
            />
          </a>
          <p>
            Premium DeFi infrastructure for passive wealth accumulation at the
            wallet layer.
          </p>
          <span class="built-on-badge">Built on Solana</span>
        </div>

        <div class="footer-links">
          <div>
            <h3>Navigation</h3>
            <a href="#home">Home</a>
            <a href="#how-it-works">How It Works</a>
            <a href="#features">Features</a>
            <a href="#waitlist">Docs</a>
            <a href="#waitlist">Blog</a>
          </div>
          <div>
            <h3>Social</h3>
            <a class="social-link" href="#community" aria-label="Helio on Twitter/X">
